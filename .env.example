# Copy to .env when running with `docker compose`.
# On ZimaOS Custom Install, these can also be set in the app's Environment UI.
TZ=Asia/Ho_Chi_Minh
TGVOIP_TTS_VOICE=vi-VN-HoaiMyNeural
TGVOIP_TTS_RATE=+0%

# Optional: configure Telegram from environment instead of the app UI.
# TGVOIP_API_ID=123456
# TGVOIP_API_HASH=your_api_hash
# TGVOIP_API_TOKEN=replace-with-a-long-random-token
